# Required: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: defaults shown. Both models need a price in src/agentic_data_analyst/usage.py, or the app will not start
# (the cost budgets need it).
# The analyst writes the SQL and the answer; the reviewer checks each query before it runs. Haiku 4.5 is the cheapest
# model; use claude-sonnet-5-5 or claude-opus-5-5 for harder questions.
ANALYST_MODEL=claude-haiku-4-5
ANALYST_REVIEWER_MODEL=claude-haiku-4-5
# Newer models only (Haiku 4.5 ignores it): low, medium, high, xhigh, max. Higher effort costs more tokens.
ANALYST_EFFORT=low
ANALYST_REVIEWER_EFFORT=low

# Hard spending limits in USD, per answer and per chat.
ANALYST_ANSWER_BUDGET_USD=0.50
ANALYST_SESSION_BUDGET_USD=5.00

# The DuckDB file written by `make data`.
ANALYST_DATABASE=data/speedruns.duckdb

# Optional: console and logs/analyst.log. One of: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
