OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DATA_CATALOG_PATH=data/sample
# Optional: point at a dbt project's compiled target/ directory (containing
# manifest.json and, optionally, catalog.json) to enrich catalog discovery
# with dbt metadata. Leave unset to run without dbt. See
# examples/dbt/gaming_analytics/README.md for a worked example.
DBT_PROJECT_PATH=
SPARK_MASTER=local[2]
MAX_RESULT_ROWS=100
LLM_TIMEOUT_SECONDS=60
MAX_LLM_RESPONSE_BYTES=1000000
EXECUTION_TIMEOUT_SECONDS=120
